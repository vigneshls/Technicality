<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFE9A8"
                android:centerColor="#FFC530"
                android:endColor="#E9973A" />
        </shape>
    </item>
    <item android:gravity="center" android:width="260dp" android:height="70dp">
        <shape android:shape="rectangle">
            <solid android:color="#2E9E3F" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
